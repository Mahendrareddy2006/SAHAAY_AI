# ==============================================================================
# Sahaay AI — Real-Time Hyderabad Flood Intelligence Configuration
# Copy this file to .env and configure authorized credentials where available.
# NOTE: Never commit sensitive keys, tokens, or credentials to version control.
# ==============================================================================

# --- Live Weather & Meteorological Ingestion ---
# Set to 'true' to enable live Hyderabad precipitation observations & hourly forecasts via Open-Meteo
SAHAAY_LIVE_WEATHER_ENABLED=true

# Official India Meteorological Department (IMD) AWS Gateway (Optional/Authorized)
SAHAAY_IMD_AWS_ENDPOINT=
SAHAAY_IMD_API_KEY=

# Telangana State Development Planning Society (TSDPS) Portal (Optional/Authorized)
SAHAAY_TSDPS_ENDPOINT=

# --- Live News, Civic Reports & RSS Feed Discovery ---
# Set to 'true' to poll permitted Hyderabad news feeds and automatically discover article images
SAHAAY_LIVE_NEWS_ENABLED=true

# Optional comma-separated list of additional RSS/Atom feeds
# Default feeds included: The Hindu Hyderabad, Google News Hyderabad Rain/Flood/Traffic Search
SAHAAY_NEWS_RSS_URLS=

# --- Authorized Community Ingestion & Webhooks ---
# Shared secret for authenticating incoming community webhooks (HMAC-SHA256)
# If empty, connector reports NOT_CONFIGURED
SAHAAY_COMMUNITY_WEBHOOK_SECRET=

# Bot token for Telegram/WhatsApp civic reporting bot
SAHAAY_COMMUNITY_BOT_TOKEN=

# --- Scheduling & Reliability ---
# Ingestion polling interval in seconds (default: 300 seconds / 5 minutes)
SAHAAY_POLL_INTERVAL_SECONDS=300

# User alert deduplication cooldown window in seconds (default: 1800 seconds / 30 minutes)
SAHAAY_NOTIFICATION_COOLDOWN_SECONDS=1800

# Strict SSRF Protection (blocks loopback, RFC1918 private, link-local, and cloud metadata IPs)
SAHAAY_SSRF_PROTECTION_ENABLED=true

# --- External Emergency Notifications (Optional/Authorized) ---
# Authorized webhook URL for external responder push/dispatch integration
# If empty, external delivery is honestly reported as NOT_CONFIGURED (in-app alerts active)
SAHAAY_EXTERNAL_NOTIF_WEBHOOK=

# SMS Gateway dispatch endpoint (Optional)
SAHAAY_SMS_GATEWAY_URL=
